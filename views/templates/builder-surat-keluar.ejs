<%- include('../layouts/base-header') %>

<!-- Include html2pdf.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="container mx-auto py-6 px-4 max-w-7xl">
  
  <!-- Header Title -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center text-xl shadow-sm border border-blue-200">
        <i class="fas fa-magic"></i>
      </div>
      <div>
        <h1 class="text-xl font-bold tracking-tight text-gray-900">Template Surat Keluar</h1>
        <p class="text-sm text-gray-500 mt-0.5">Buat surat dinas otomatis dan unduh sebagai PDF</p>
      </div>
    </div>
    
    <button type="button" onclick="downloadPDF()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-sm transition flex items-center space-x-2 shadow-sm">
      <i class="fas fa-file-pdf"></i>
      <span>Unduh PDF</span>
    </button>
  </div>

  <div class="space-y-8">
    
    <!-- Top Section: Form Builder -->
    <div class="space-y-4">
      <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
        <h2 class="text-sm font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
          <i class="fas fa-pen-nib text-indigo-500"></i> Pengisian Data Surat
        </h2>
        
        <form id="builderForm" class="space-y-4 text-sm">
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Tanggal Surat</label>
              <input type="date" id="inputTanggal" value="" oninput="updatePreview()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Nomor Surat</label>
              <input type="text" id="inputNomor" value="" oninput="updatePreview()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm font-mono text-xs" placeholder="Masukan Nomor Surat">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Sifat</label>
              <select id="inputSifat" oninput="updatePreview()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm bg-white">
                <option value="Biasa">Biasa</option>
                <option value="Penting">Penting</option>
                <option value="Segera">Segera</option>
                <option value="Sangat Segera / Kilat">Sangat Segera / Kilat</option>
                <option value="Rahasia">Rahasia</option>
                <option value="Sangat Rahasia">Sangat Rahasia</option>
                <option value="Terbatas">Terbatas</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Lampiran</label>
              <input type="text" id="inputLampiran" value="" oninput="updatePreview()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm" placeholder="Masukan Lampiran Surat">
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Perihal / Hal</label>
            <input type="text" id="inputHal" value="" oninput="updatePreview()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm" placeholder="Masukan Perihal Surat">
          </div>

          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <h3 class="text-xs font-bold text-slate-800 mb-2">Tujuan Surat</h3>
            <div class="space-y-3">
              <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Yth. (Penerima)</label>
                <input type="text" id="inputPenerima" value="" oninput="updatePreview()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm" placeholder="Masukan Tujuan Surat">
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Di (Tempat)</label>
                <input type="text" id="inputTempat" value="" oninput="updatePreview()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm" placeholder="Masukan Tempat Tujuan">
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Isi Surat (Gunakan tag HTML ringan seperti &lt;p&gt; atau &lt;br&gt; jika perlu)</label>
            <textarea id="inputIsi" rows="8" oninput="updatePreview()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm leading-relaxed" placeholder="Ketik isi surat di sini..."></textarea>
          </div>

          <div class="bg-indigo-50 p-3 rounded-xl border border-indigo-100">
            <h3 class="text-xs font-bold text-indigo-900 mb-2">Penandatangan</h3>
            <div class="space-y-3">
              <div>
                <label class="block text-xs font-bold text-indigo-700 mb-1">Nama Pejabat</label>
                <select id="selectPejabat" onchange="handlePejabatChange()" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm bg-white">
                  <option value="">-- Pilih Pejabat --</option>
                  <% pegawaiList.forEach(p => { %>
                    <option value="<%= p.id %>" data-nama="<%= p.nama %>" data-jabatan="<%= p.jabatan %>" data-nip="<%= p.nip %>"><%= p.nama %></option>
                  <% }) %>
                </select>
                <!-- Hidden inputs to store actual values for preview -->
                <input type="hidden" id="inputNamaPejabat" value="">
              </div>
              <div>
                <label class="block text-xs font-bold text-indigo-700 mb-1">Jabatan Tanda Tangan</label>
                <input type="text" id="inputJabatanTtd" value="" readonly class="w-full px-3 py-2 border border-indigo-200 bg-indigo-50/50 rounded-lg text-sm text-gray-500 cursor-not-allowed">
              </div>
              <div>
                <label class="block text-xs font-bold text-indigo-700 mb-1">NIP Pejabat</label>
                <input type="text" id="inputNipPejabat" value="" readonly class="w-full px-3 py-2 border border-indigo-200 bg-indigo-50/50 rounded-lg text-sm font-mono text-xs text-gray-500 cursor-not-allowed">
              </div>
            </div>
          </div>

        </form>
      </div>
    </div>

    <!-- Bottom Section: Live Preview (A4 Paper Mode) -->
    <div>
      <div id="previewContainer" class="bg-gray-100 p-4 rounded-2xl border border-gray-200 shadow-inner overflow-y-auto overflow-x-hidden flex justify-center scrollbar-thin max-h-[85vh]">
        
        <!-- Document Container (Target for PDF) -->
        <div id="suratDocument" class="bg-white border border-gray-300 shadow-lg shrink-0 relative overflow-hidden origin-top flex flex-col" style="width: 210mm; min-height: 297mm; padding: 25mm 20mm 45mm 20mm; font-family: 'Times New Roman', Times, serif; color: black; line-height: 1.5; transition: transform 0.2s ease;">
          
          <!-- Kop Surat -->
          <div style="margin-bottom: 1rem;">
            <table style="width: 100%; border-bottom: 3px solid black; padding-bottom: 0.5rem;" cellpadding="0" cellspacing="0">
              <tr>
                <td style="width: 100px; text-align: left; vertical-align: middle;">
                  <img src="/static/assets/images/logo_pa_original.png" alt="Logo" style="width: 90px; height: auto;">
                </td>
                <td style="text-align: center; vertical-align: middle; padding: 0 10px; font-family: 'Times New Roman', Times, serif; color: black;">
                  <div style="font-size: 14pt; font-weight: bold; text-transform: uppercase; line-height: 1.2;">MAHKAMAH AGUNG REPUBLIK INDONESIA</div>
                  <div style="font-size: 13pt; font-weight: bold; text-transform: uppercase; line-height: 1.2;">DIREKTORAT JENDERAL BADAN PERADILAN AGAMA</div>
                  <div style="font-size: 13pt; font-weight: bold; text-transform: uppercase; line-height: 1.2;">PENGADILAN TINGGI AGAMA BANJARMASIN</div>
                  <div style="font-size: 16pt; font-weight: bold; text-transform: uppercase; line-height: 1.2; margin-top: 2px;">PENGADILAN AGAMA BANJARBARU</div>
                  <div style="font-size: 10pt; line-height: 1.2; margin-top: 4px;">Jalan Trikora Nomor 4, Kelurahan Kemuning, Kecamatan Banjarbaru Selatan,</div>
                  <div style="font-size: 10pt; line-height: 1.2;">Kota Banjarbaru, Kalimantan Selatan, www.pa-banjarbaru.go.id, pa.banjarbaru@gmail.com</div>
                </td>
                <td style="width: 100px;"></td>
              </tr>
            </table>
            <div style="border-bottom: 1px solid black; margin-top: 2px;"></div>
          </div>

          <div class="text-right mb-6 text-[11pt]">
            <span id="previewTanggal"></span>
          </div>

          <div class="flex gap-4 mb-6 text-[11pt]">
            <div class="w-[70px]">
              <div>Nomor</div>
              <div>Sifat</div>
              <div>Lampiran</div>
              <div>Hal</div>
            </div>
            <div>
              <div>: <span id="previewNomor"></span></div>
              <div>: <span id="previewSifat"></span></div>
              <div>: <span id="previewLampiran"></span></div>
              <div>: <span id="previewHal"></span></div>
            </div>
          </div>

          <div class="mb-6 text-[11pt] max-w-[60%]">
            <div>Yth. <span id="previewPenerima"></span></div>
            <div>di <span id="previewTempat"></span></div>
          </div>

          <div class="mb-4 text-[11pt]">
            Assalamu'alaikum Wr. Wb.
          </div>

          <!-- Letter Content -->
          <div id="previewIsi" class="text-justify text-[11pt] space-y-3 whitespace-pre-wrap leading-relaxed indent-10 break-words pr-2"></div>

          <div class="mt-4 text-[11pt]">
            Hormat kami,
          </div>

          <!-- Signature Block -->
          <div id="signatureBlock" class="flex justify-end mt-auto relative pt-8" style="page-break-inside: avoid;">
            <div class="w-[300px] font-sans">
              <div id="previewJabatanTtd" class="text-[11pt] font-serif mb-2"></div>
              
              <!-- E-Signature Badge -->
              <div class="flex items-center gap-2 border-l-4 border-emerald-600 pl-2 my-2 relative">
                <!-- Digital Seal Overlay -->
                <div class="absolute -left-6 opacity-30 text-emerald-800">
                  <i class="fas fa-stamp text-4xl -rotate-12"></i>
                </div>
                <div class="bg-emerald-800 rounded-full w-8 h-8 flex items-center justify-center text-yellow-400 shrink-0 border border-yellow-400">
                   <i class="fas fa-shield-alt text-sm"></i>
                </div>
                <div class="text-[7pt] font-bold uppercase text-black leading-[1.2]">
                  DITANDATANGANI SECARA ELEKTRONIK OLEH:<br>
                  <span id="previewJabatanTtd2"></span><br>
                  <span id="previewNamaPejabatBadge"></span><br>
                  <span id="previewNipPejabatBadge"></span>
                </div>
              </div>

              <!-- Real Signature Text -->
              <div class="mt-4 text-[11pt] font-serif font-bold underline" id="previewNamaPejabatUtama"></div>
              <div class="text-[11pt] font-serif" id="previewNipPejabatUtama"></div>

            </div>
          </div>

          <!-- Footer Watermark / Disclaimer -->
          <div id="footerWatermark" class="absolute bottom-[20mm] left-[20mm] right-[20mm] border-t border-gray-400 pt-3 flex justify-between items-end font-sans">
            <div class="text-[8pt] text-gray-700 flex gap-2">
              <i class="fas fa-shield-check text-blue-600"></i>
              <span>Dokumen ini telah ditandatangani secara digital menggunakan sertifikat elektronik yang diterbitkan oleh Balai Sertifikasi Elektronik (BSrE) BSSN.</span>
            </div>
            <div class="flex items-center gap-1 opacity-80 h-6 shrink-0">
              <div class="font-extrabold italic text-red-600 text-xs">BerAKHLAK</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

</div>

<script>
  function adjustScale() {
    const container = document.getElementById('previewContainer');
    const doc = document.getElementById('suratDocument');
    if (!container || !doc) return;
    
    // Temporarily reset to get real dimensions
    doc.style.transition = 'none';
    doc.style.transform = 'none';
    doc.style.marginBottom = '0px';
    
    const docWidth = doc.offsetWidth || 794; 
    const docHeight = doc.offsetHeight || 1123;
    const containerWidth = container.clientWidth - 32; 
    
    let scale = containerWidth / docWidth;
    if (scale > 1.0) scale = 1.0; // Cap max zoom
    
    doc.style.transform = `scale(${scale})`;
    
    const scaledHeight = docHeight * scale;
    doc.style.marginBottom = `-${docHeight - scaledHeight}px`; 
    
    // Restore transition
    setTimeout(() => {
      doc.style.transition = 'transform 0.2s ease';
    }, 50);
  }


  function updatePreview() {
    const tglVal = document.getElementById('inputTanggal').value;
    let tglText = "";
    if (tglVal) {
      const d = new Date(tglVal);
      const months = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
      if (!isNaN(d.getTime())) {
        tglText = `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
      } else {
        tglText = tglVal;
      }
    }
    document.getElementById('previewTanggal').innerText = tglText;
    document.getElementById('previewNomor').innerText = document.getElementById('inputNomor').value;
    document.getElementById('previewSifat').innerText = document.getElementById('inputSifat').value;
    document.getElementById('previewLampiran').innerText = document.getElementById('inputLampiran').value;
    document.getElementById('previewHal').innerText = document.getElementById('inputHal').value;
    document.getElementById('previewPenerima').innerText = document.getElementById('inputPenerima').value;
    document.getElementById('previewTempat').innerText = document.getElementById('inputTempat').value;
    
    // Formatting the isi content
    let rawIsi = document.getElementById('inputIsi').value;
    let formattedIsi = rawIsi.replace(/\n\n/g, '<br><br>').replace(/\n/g, '<br>');
    document.getElementById('previewIsi').innerHTML = formattedIsi;

    document.getElementById('previewJabatanTtd').innerText = document.getElementById('inputJabatanTtd').value;
    document.getElementById('previewJabatanTtd2').innerText = document.getElementById('inputJabatanTtd').value;
    document.getElementById('previewNamaPejabatBadge').innerText = document.getElementById('inputNamaPejabat').value;
    document.getElementById('previewNamaPejabatUtama').innerText = document.getElementById('inputNamaPejabat').value;
    document.getElementById('previewNipPejabatBadge').innerText = document.getElementById('inputNipPejabat').value;
    document.getElementById('previewNipPejabatUtama').innerText = document.getElementById('inputNipPejabat').value ? 'NIP. ' + document.getElementById('inputNipPejabat').value : '';
    
    adjustScale();
    
    
    setTimeout(() => {
      const doc = document.getElementById('suratDocument');
      doc.style.height = 'auto'; // reset
      const h = doc.scrollHeight;
      const pageH = doc.offsetWidth * (297 / 210);
      const pages = Math.ceil(h / pageH);
      doc.style.height = (pages * 297) + 'mm';
      
      // Visual indicator for multiple pages
      if (pages > 1) {
        doc.style.background = `repeating-linear-gradient(to bottom, white, white calc(${pageH}px - 2px), #9ca3af calc(${pageH}px - 2px), #9ca3af ${pageH}px)`;
      } else {
        doc.style.background = 'white';
      }
    }, 10);

  }

  function downloadPDF() {
    const element = document.getElementById('suratDocument');
    const nomorInput = document.getElementById('inputNomor').value;
    const nomor = nomorInput ? nomorInput.replace(/[^a-zA-Z0-9-]/g, '_') : 'Tanpa_Nomor';
    
    const oldTransform = element.style.transform;
    const oldMarginBottom = element.style.marginBottom;
    const oldClass = element.className;
    const oldTransition = element.style.transition;
    
    const oldWidth = element.style.width;
    const oldPadding = element.style.padding;
    const oldMinHeight = element.style.minHeight;
    const oldHeight = element.style.height;
    
    element.style.transition = 'none';
    element.style.transform = 'none';
    element.style.marginBottom = '0px';
    element.className = 'bg-white shrink-0 relative overflow-hidden flex flex-col';
    
    const oldBg = element.style.background;
    element.style.background = 'white';
    
    // For PDF generation, remove internal padding and let html2pdf handle margins
    // 210mm - 20mm left - 20mm right = 170mm
    element.style.width = '170mm';
    element.style.padding = '0mm 0mm 30mm 0mm';
    element.style.minHeight = '257mm'; // 297 - 20 top - 20 bottom
        element.style.height = 'auto';
    
    // Snap height to multiple of 257mm so footer is at absolute bottom of the last page in PDF
    const h = element.scrollHeight;
    const pxPerMm = element.offsetWidth / 170; // 170mm is the width we set
    const pageHPx = 257 * pxPerMm;
    const pages = Math.ceil(h / pageHPx);
    element.style.height = (pages * 257) + 'mm';
    
    // Also move footer so it sits properly at bottom
    const footer = document.getElementById('footerWatermark');
    const oldFooterClass = footer ? footer.className : '';
    if (footer) {
      footer.className = 'absolute bottom-0 left-0 right-0 border-t border-gray-400 pt-3 flex justify-between items-end font-sans';
    }
    
    const opt = {
      margin:       [20, 20, 20, 20], // top, left, bottom, right
      filename:     `Surat_Keluar_${nomor}.pdf`,
      image:        { type: 'jpeg', quality: 1 },
      html2canvas:  { scale: 2, useCORS: true },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
      pagebreak:    { mode: ['css', 'legacy'] }
    };

    setTimeout(() => {
      html2pdf().set(opt).from(element).save().then(() => {
        element.className = oldClass;
        element.style.transform = oldTransform;
        element.style.marginBottom = oldMarginBottom;
        element.style.transition = oldTransition;
        element.style.background = oldBg;
        
        element.style.width = oldWidth;
        element.style.padding = oldPadding;
        element.style.minHeight = oldMinHeight;
        element.style.height = oldHeight;
        if (footer) footer.className = oldFooterClass;
        
        adjustScale();
      });
    }, 50);
  }

  window.addEventListener('resize', adjustScale);

  // Initialize preview on load
  document.addEventListener('DOMContentLoaded', () => {
    updatePreview();
    setTimeout(adjustScale, 100);
  });
</script>


<script>
  function handlePejabatChange() {
    const select = document.getElementById('selectPejabat');
    const selected = select.options[select.selectedIndex];
    
    if (selected && selected.value) {
      document.getElementById('inputNamaPejabat').value = selected.getAttribute('data-nama');
      document.getElementById('inputJabatanTtd').value = selected.getAttribute('data-jabatan');
      document.getElementById('inputNipPejabat').value = selected.getAttribute('data-nip');
    } else {
      document.getElementById('inputNamaPejabat').value = '';
      document.getElementById('inputJabatanTtd').value = '';
      document.getElementById('inputNipPejabat').value = '';
    }
    
    updatePreview();
  }
</script>
<%- include('../layouts/base-footer') %>
