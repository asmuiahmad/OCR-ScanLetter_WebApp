<!-- FLOATING MINIMIZED WINDOWS DOCK (BAR DIBAWAH MULTI-WINDOW) -->
<div id="minimizedDock" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-[10000] hidden flex items-center gap-3 bg-slate-900/95 text-white px-4 py-2.5 rounded-2xl border border-slate-700/80 shadow-2xl backdrop-blur-md text-xs transition-all duration-300 max-w-[90vw] overflow-x-auto">
  <div class="flex items-center gap-2 text-amber-400 font-bold text-[11px] uppercase tracking-wider pr-3 border-r border-slate-700/80 shrink-0">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
    </span>
    <i class="fas fa-window-restore"></i> Minimized (<span id="minimizedCount">0</span>)
  </div>
  <div id="minimizedDockItems" class="flex items-center gap-2 overflow-x-auto py-0.5 scrollbar-none"></div>
</div>

<script>
let activeZIndex = 10000;
const minimizedModals = {};

function bringToFront(modal) {
  if (!modal) return;
  activeZIndex++;
  modal.style.zIndex = activeZIndex;
}

function getOrCloneModal(templateId, modalId) {
  let modal = document.getElementById(modalId);
  if (!modal) {
    const template = document.getElementById(templateId);
    if (!template) return null;
    modal = template.cloneNode(true);
    modal.id = modalId;
    document.body.appendChild(modal);
  }
  bringToFront(modal);
  return modal;
}

function toggleModalFullscreen(modalId) {
  const modal = document.getElementById(modalId) || document.getElementById('detailSuratModal');
  if (!modal) return;
  const card = modal.querySelector('.bg-white');
  if (!card) return;

  if (card.classList.contains('is-fullscreen')) {
    card.classList.remove('is-fullscreen', 'max-w-none', 'w-[96vw]', 'max-h-[95vh]');
    if (card.dataset.origMax) {
      card.classList.add(card.dataset.origMax);
    } else {
      card.classList.add('max-w-xl');
    }
  } else {
    if (card.classList.contains('max-w-xl')) card.dataset.origMax = 'max-w-xl';
    else if (card.classList.contains('max-w-lg')) card.dataset.origMax = 'max-w-lg';
    
    card.classList.remove('max-w-xl', 'max-w-lg');
    card.classList.add('is-fullscreen', 'max-w-none', 'w-[96vw]', 'max-h-[95vh]');
  }
}

function minimizeModal(modalId, defaultTitle) {
  const id = modalId || 'detailSuratModal';
  const modal = document.getElementById(id);
  if (!modal) return;
  const card = modal.querySelector('.bg-white');
  if (!card) return;

  card.classList.add('scale-90', 'opacity-0');
  setTimeout(() => {
    modal.classList.add('hidden');
    card.classList.remove('scale-90', 'opacity-0');
  }, 200);

  let displayTitle = defaultTitle || 'Dokumen Surat';
  const nomorEl = modal.querySelector('#modalNomor') || modal.querySelector('#editNomor');
  if (nomorEl && nomorEl.innerText && nomorEl.innerText.trim() !== '-') {
    displayTitle = (id.includes('edit') ? 'Edit: ' : 'Detail: ') + nomorEl.innerText.trim();
  } else if (nomorEl && nomorEl.value && nomorEl.value.trim() !== '') {
    displayTitle = (id.includes('edit') ? 'Edit: ' : 'Detail: ') + nomorEl.value.trim();
  }

  minimizedModals[id] = { title: displayTitle };
  renderMinimizedDock();
}

function restoreModal(modalId) {
  const modal = document.getElementById(modalId);
  if (!modal) return;
  modal.classList.remove('hidden');
  bringToFront(modal);
  const card = modal.querySelector('.bg-white');
  if (card) {
    card.classList.add('scale-95');
    setTimeout(() => card.classList.remove('scale-95'), 50);
  }
  delete minimizedModals[modalId];
  renderMinimizedDock();
}

function removeMinimizedModal(modalId) {
  if (minimizedModals[modalId]) {
    delete minimizedModals[modalId];
    renderMinimizedDock();
  }
}

function renderMinimizedDock() {
  const dock = document.getElementById('minimizedDock');
  const itemsContainer = document.getElementById('minimizedDockItems');
  const countEl = document.getElementById('minimizedCount');
  if (!dock || !itemsContainer) return;

  const keys = Object.keys(minimizedModals);
  if (keys.length === 0) {
    dock.classList.add('hidden');
    itemsContainer.innerHTML = '';
    return;
  }

  if (countEl) countEl.innerText = keys.length;
  dock.classList.remove('hidden');

  itemsContainer.innerHTML = keys.map(id => {
    const item = minimizedModals[id];
    const isEdit = id.includes('edit');
    const iconClass = isEdit ? 'fa-edit text-amber-400' : 'fa-paper-plane text-amber-400';

    return `
      <div class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700/90 text-slate-100 px-3 py-1.5 rounded-xl border border-slate-700/80 transition-all group shadow-sm shrink-0">
        <button type="button" onclick="restoreModal('${id}')" class="flex items-center gap-1.5 text-xs font-semibold hover:text-white transition">
          <i class="fas ${iconClass} text-xs group-hover:scale-110 transition-transform"></i>
          <span class="max-w-[180px] truncate">${item.title}</span>
        </button>
        <button type="button" onclick="closeModalCompletely('${id}')" class="p-1 text-slate-400 hover:text-rose-400 hover:bg-slate-700 rounded-lg transition ml-0.5" title="Tutup Window">
          <i class="fas fa-times text-xs"></i>
        </button>
      </div>
    `;
  }).join('');
}

function closeModalCompletely(modalId) {
  if (modalId && modalId.includes('detail')) closeDetailModal(modalId);
  else if (modalId && modalId.includes('edit')) closeEditModal(modalId);
  else {
    const modal = document.getElementById(modalId);
    if (modal) modal.classList.add('hidden');
  }
  removeMinimizedModal(modalId);
}

function openDetailModal(type, entry) {
  const modalId = `detailModal-${type.toLowerCase()}-${entry.id || Math.random().toString(36).substring(2,7)}`;
  const modal = getOrCloneModal('detailSuratModal', modalId);
  if (!modal) return;

  modal.dataset.entry = JSON.stringify(entry);
  modal.dataset.type = type;

  modal.setAttribute('onclick', `if(event.target === this) closeDetailModal('${modalId}')`);

  const closeBtn = modal.querySelector('.btn-close-window');
  if (closeBtn) closeBtn.setAttribute('onclick', `closeDetailModal('${modalId}')`);

  const minBtn = modal.querySelector('.btn-min-window');
  if (minBtn) minBtn.setAttribute('onclick', `minimizeModal('${modalId}', 'Detail Surat: ${entry.nomor || '-'}')`);

  const fullBtn = modal.querySelector('.btn-full-window');
  if (fullBtn) fullBtn.setAttribute('onclick', `toggleModalFullscreen('${modalId}')`);

  const bottomCloseBtn = modal.querySelector('.btn-bottom-close');
  if (bottomCloseBtn) bottomCloseBtn.setAttribute('onclick', `closeDetailModal('${modalId}')`);

  const titleEl = modal.querySelector('#modalTitle');
  if (titleEl) titleEl.innerText = 'Detail Surat ' + type;

  const nomorEl = modal.querySelector('#modalNomor');
  if (nomorEl) nomorEl.innerText = entry.nomor || '-';

  const tanggalEl = modal.querySelector('#modalTanggal');
  if (tanggalEl) tanggalEl.innerText = entry.tanggal || '-';

  const pengirimEl = modal.querySelector('#modalPengirim');
  if (pengirimEl) pengirimEl.innerText = entry.pengirim || '-';

  const penerimaEl = modal.querySelector('#modalPenerima');
  if (penerimaEl) penerimaEl.innerText = entry.penerima || '-';

  const isiEl = modal.querySelector('#modalIsi');
  if (isiEl) isiEl.innerText = entry.isi || '-';

  const createdEl = modal.querySelector('#modalCreatedAt');
  if (createdEl) createdEl.innerText = entry.created_at || '-';

  const statusBadge = modal.querySelector('#modalStatusBadge');
  if (statusBadge) {
    if (entry.status === 'approved') {
      statusBadge.innerHTML = '<span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full font-bold text-xs"><i class="fas fa-check-circle mr-1"></i> Disetujui</span>';
    } else if (entry.status === 'rejected') {
      statusBadge.innerHTML = '<span class="px-3 py-1 bg-rose-100 text-rose-800 rounded-full font-bold text-xs"><i class="fas fa-times-circle mr-1"></i> Ditolak</span>';
    } else {
      statusBadge.innerHTML = '<span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full font-bold text-xs"><i class="fas fa-clock mr-1"></i> Pending</span>';
    }
  }

  const appContainer = modal.querySelector('#modalApprovedByContainer');
  const appEl = modal.querySelector('#modalApprovedBy');
  if (appContainer && appEl) {
    if (entry.approved_by) {
      appContainer.style.display = 'block';
      appEl.innerText = entry.approved_by;
    } else {
      appContainer.style.display = 'none';
    }
  }

  removeMinimizedModal(modalId);
  modal.classList.remove('hidden');
}

function previewSuratFisikFromModal(btn) {
  const modal = btn.closest('[id^="detailModal"]') || btn.closest('#detailSuratModal');
  if (modal && modal.dataset.entry) {
    try {
      const entry = JSON.parse(modal.dataset.entry);
      const type = modal.dataset.type || 'Keluar';
      openPreviewFisikModal(type, entry);
    } catch(e) {
      console.error('Error parsing entry for preview:', e);
    }
  }
}

function openPreviewFisikModal(type, entry) {
  const modalId = `previewModal-${type.toLowerCase()}-${entry.id || Math.random().toString(36).substring(2,7)}`;
  const modal = getOrCloneModal('previewSuratFisikModalTemplate', modalId);
  if (!modal) return;

  modal.dataset.zoom = '1';

  modal.setAttribute('onclick', `if(event.target === this) closePreviewFisikModal('${modalId}')`);

  const closeBtn = modal.querySelector('.btn-close-window');
  if (closeBtn) closeBtn.setAttribute('onclick', `closePreviewFisikModal('${modalId}')`);

  const minBtn = modal.querySelector('.btn-min-window');
  if (minBtn) minBtn.setAttribute('onclick', `minimizeModal('${modalId}', 'Preview: ${entry.nomor || '-'}')`);

  const fullBtn = modal.querySelector('.btn-full-window');
  if (fullBtn) fullBtn.setAttribute('onclick', `toggleModalFullscreen('${modalId}')`);

  const windowTitle = modal.querySelector('.pf-window-title');
  if (windowTitle) windowTitle.innerText = `Preview Physical Letter (${type}): ${entry.nomor || ''}`;

  const nomorEl = modal.querySelector('.pf-nomor');
  if (nomorEl) nomorEl.innerText = entry.nomor || 'W15-A12/902/HM.01/VII/2026';

  const perihalEl = modal.querySelector('.pf-perihal');
  if (perihalEl) perihalEl.innerText = entry.isi || 'Penyampaian Berkas Dokumen Resmi';

  const tanggalEl = modal.querySelector('.pf-tanggal');
  if (tanggalEl) {
    const rawDate = entry.tanggal ? new Date(entry.tanggal) : new Date();
    const formatted = !isNaN(rawDate.getTime()) 
      ? rawDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
      : entry.tanggal || '19 Juli 2026';
    tanggalEl.innerText = 'Banjarbaru, ' + formatted;
  }

  const pengirimEl = modal.querySelector('.pf-pengirim-title');
  if (pengirimEl) pengirimEl.innerText = entry.pengirim || 'Pengadilan Agama Banjarbaru';

  const penerimaEl = modal.querySelector('.pf-penerima');
  if (penerimaEl) penerimaEl.innerText = entry.penerima || 'Ketua Pengadilan Agama Banjarbaru';

  const isiEl = modal.querySelector('.pf-isi');
  if (isiEl) isiEl.innerText = entry.isi || 'Surat resminya telah diregistrasi di database Pengadilan Agama Banjarbaru.';

  const signerEl = modal.querySelector('.pf-signer');
  if (signerEl) signerEl.innerText = entry.approved_by || entry.pengirim || 'Drs. H. Muhammad, M.H.';

  const stampEl = modal.querySelector('.pf-stamp');
  if (stampEl) {
    if (entry.status === 'approved') {
      stampEl.className = 'pf-stamp absolute top-10 right-10 border-4 border-emerald-600/80 text-emerald-700 font-extrabold uppercase px-3 py-1.5 rounded-xl text-xs rotate-[-12deg] pointer-events-none select-none tracking-widest bg-emerald-50/50 backdrop-blur-xs flex items-center gap-1.5 shadow-sm';
      stampEl.innerHTML = '<i class="fas fa-check-circle text-sm"></i> DISETUJUI / VALID';
    } else if (entry.status === 'rejected') {
      stampEl.className = 'pf-stamp absolute top-10 right-10 border-4 border-rose-600/80 text-rose-700 font-extrabold uppercase px-3 py-1.5 rounded-xl text-xs rotate-[-12deg] pointer-events-none select-none tracking-widest bg-rose-50/50 backdrop-blur-xs flex items-center gap-1.5 shadow-sm';
      stampEl.innerHTML = '<i class="fas fa-times-circle text-sm"></i> DITOLAK';
    } else {
      stampEl.className = 'pf-stamp absolute top-10 right-10 border-4 border-amber-600/80 text-amber-700 font-extrabold uppercase px-3 py-1.5 rounded-xl text-xs rotate-[-12deg] pointer-events-none select-none tracking-widest bg-amber-50/50 backdrop-blur-xs flex items-center gap-1.5 shadow-sm';
      stampEl.innerHTML = '<i class="fas fa-clock text-sm"></i> DRAFT / PENDING';
    }
  }

  removeMinimizedModal(modalId);
  modal.classList.remove('hidden');
}

function closePreviewFisikModal(modalId) {
  const id = modalId || 'previewSuratFisikModalTemplate';
  const modal = document.getElementById(id);
  if (modal) {
    const card = modal.querySelector('.bg-slate-100');
    if (card && card.classList.contains('is-fullscreen')) {
      toggleModalFullscreen(id);
    }
    modal.classList.add('hidden');
    if (id !== 'previewSuratFisikModalTemplate') {
      modal.remove();
    }
  }
  removeMinimizedModal(id);
}

function zoomPaperModal(btn, delta) {
  const modal = btn.closest('[id^="previewModal"]') || btn.closest('#previewSuratFisikModalTemplate');
  if (!modal) return;
  const paper = modal.querySelector('.pf-paper');
  if (!paper) return;
  let zoom = parseFloat(modal.dataset.zoom || '1') + delta;
  zoom = Math.min(Math.max(0.6, zoom), 1.4);
  modal.dataset.zoom = zoom.toString();
  paper.style.transform = `scale(${zoom})`;
  paper.style.transformOrigin = 'top center';
}

function printPhysicalDocument(btn) {
  const modal = btn.closest('[id^="previewModal"]') || btn.closest('#previewSuratFisikModalTemplate');
  if (!modal) {
    window.print();
    return;
  }
  const paper = modal.querySelector('.pf-paper');
  if (!paper) {
    window.print();
    return;
  }
  
  const printWin = window.open('', '_blank', 'width=800,height=900');
  if (printWin) {
    printWin.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Cetak Surat Fisik Resmi</title>
        <script src="https://cdn.tailwindcss.com"><\/script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <style>
          @page { size: A4; margin: 15mm; }
          body { font-family: Georgia, serif; background: white; color: black; }
        </style>
      </head>
      <body class="p-6">
        <div class="max-w-2xl mx-auto">
          ${paper.outerHTML}
        </div>
        <script>
          setTimeout(() => {
            window.print();
          }, 600);
        <\/script>
      </body>
      </html>
    `);
    printWin.document.close();
  } else {
    window.print();
  }
}

function closeDetailModal(modalId) {
  const id = modalId || 'detailSuratModal';
  const modal = document.getElementById(id);
  if (modal) {
    const card = modal.querySelector('.bg-white');
    if (card && card.classList.contains('is-fullscreen')) {
      toggleModalFullscreen(id);
    }
    modal.classList.add('hidden');
    if (id !== 'detailSuratModal') {
      modal.remove();
    }
  }
  removeMinimizedModal(id);
}

function openEditModal(type, entry) {
  const modalId = `editModal-${type.toLowerCase()}-${entry.id || Math.random().toString(36).substring(2,7)}`;
  const modal = getOrCloneModal('editSuratModal', modalId);
  if (!modal) return;

  modal.setAttribute('onclick', `if(event.target === this) closeEditModal('${modalId}')`);

  const closeBtn = modal.querySelector('.btn-close-window');
  if (closeBtn) closeBtn.setAttribute('onclick', `closeEditModal('${modalId}')`);

  const minBtn = modal.querySelector('.btn-min-window');
  if (minBtn) minBtn.setAttribute('onclick', `minimizeModal('${modalId}', 'Edit Surat: ${entry.nomor || '-'}')`);

  const fullBtn = modal.querySelector('.btn-full-window');
  if (fullBtn) fullBtn.setAttribute('onclick', `toggleModalFullscreen('${modalId}')`);

  const cancelBtn = modal.querySelector('.btn-cancel-edit');
  if (cancelBtn) cancelBtn.setAttribute('onclick', `closeEditModal('${modalId}')`);

  const form = modal.querySelector('form');
  if (form) form.setAttribute('onsubmit', `submitEditForm(event, '${modalId}')`);

  const editType = modal.querySelector('#editType');
  if (editType) editType.value = type.toLowerCase();

  const editId = modal.querySelector('#editId');
  if (editId) editId.value = entry.id;

  const editNomor = modal.querySelector('#editNomor');
  if (editNomor) editNomor.value = entry.nomor || '';

  const editTanggal = modal.querySelector('#editTanggal');
  if (editTanggal) editTanggal.value = entry.tanggal || '';

  const editStatus = modal.querySelector('#editStatus');
  if (editStatus) editStatus.value = entry.status || 'pending';

  const editPengirim = modal.querySelector('#editPengirim');
  if (editPengirim) editPengirim.value = entry.pengirim || '';

  const editPenerima = modal.querySelector('#editPenerima');
  if (editPenerima) editPenerima.value = entry.penerima || '';

  const editIsi = modal.querySelector('#editIsi');
  if (editIsi) editIsi.value = entry.isi || '';

  removeMinimizedModal(modalId);
  modal.classList.remove('hidden');
}

function closeEditModal(modalId) {
  const id = modalId || 'editSuratModal';
  const modal = document.getElementById(id);
  if (modal) {
    const card = modal.querySelector('.bg-white');
    if (card && card.classList.contains('is-fullscreen')) {
      toggleModalFullscreen(id);
    }
    modal.classList.add('hidden');
    if (id !== 'editSuratModal') {
      modal.remove();
    }
  }
  removeMinimizedModal(id);
}

async function submitEditForm(e, modalId) {
  e.preventDefault();
  const id = modalId || 'editSuratModal';
  const modal = document.getElementById(id);
  if (!modal) return;

  const type = modal.querySelector('#editType').value;
  const suratId = modal.querySelector('#editId').value;
  const payload = {
    nomor: modal.querySelector('#editNomor').value,
    tanggal: modal.querySelector('#editTanggal').value,
    status: modal.querySelector('#editStatus').value,
    pengirim: modal.querySelector('#editPengirim').value,
    penerima: modal.querySelector('#editPenerima').value,
    isi: modal.querySelector('#editIsi').value
  };

  try {
    const res = await fetch(`/api/surat-${type}/${suratId}/update`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      alert('Data surat berhasil diperbarui!');
      window.location.reload();
    } else {
      alert(data.message || 'Gagal memperbarui surat.');
    }
  } catch (err) {
    alert('Terjadi kesalahan jaringan.');
  }
}

async function deleteSurat(type, id, nomor) {
  if (confirm(`Apakah Anda yakin ingin menghapus Surat ${type.toUpperCase()} No: "${nomor}"?`)) {
    try {
      const res = await fetch(`/api/surat-${type}/${id}/delete`, {
        method: 'POST'
      });
      const data = await res.json();
      if (data.success) {
        const row = document.getElementById(`row-${type}-${id}`);
        if (row) row.remove();
        alert(`Surat ${nomor} berhasil dihapus.`);
      } else {
        alert(data.message || 'Gagal menghapus surat.');
      }
    } catch (err) {
      alert('Terjadi kesalahan sistem.');
    }
  }
}
</script>

