          <i class="fas fa-print"></i> Cetak
        </button>
        <button type="button" onclick="closePreviewFisikModal(this.closest('[id^=\'preview\']').id)" class="btn-bottom-close px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-xl transition">
