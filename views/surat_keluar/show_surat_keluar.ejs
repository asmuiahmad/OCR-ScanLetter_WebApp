              <div class="pf-tanggal">Banjarbaru, 19 Juli 2026</div>
            </div>
          </div>

          <!-- Destination Address -->
          <div class="mb-6 font-sans text-xs space-y-1">
            <div>Kepada Yth.</div>
            <div class="pf-penerima font-bold text-slate-900 text-sm">Wali Kota Banjarbaru</div>
