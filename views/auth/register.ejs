<%- include('../layouts/base-login-header') %>

<div class="text-center mb-5">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white shadow-lg shadow-indigo-500/25 mb-2 transform transition hover:scale-105">
    <i class="fas fa-user-plus text-xl"></i>
  </div>
  <h1 class="text-lg font-extrabold text-slate-800 tracking-tight m-0 uppercase">Pendaftaran Akun Baru</h1>
  <p class="text-xs font-semibold text-indigo-600 tracking-wider uppercase mt-0.5">Sistem Informasi Persuratan & OCR</p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs font-medium shadow-sm flex items-center justify-center gap-2">
    <i class="fas fa-exclamation-circle text-rose-500 text-sm flex-shrink-0"></i>
    <span><%= error %></span>
  </div>
<% } %>

<form action="/auth/register" method="POST" class="space-y-3" id="registerForm">
  <div>
    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
      Nama Lengkap <span class="text-rose-500">*</span>
    </label>
    <div class="relative flex items-center">
      <div class="absolute left-3 text-slate-400 pointer-events-none text-xs">
        <i class="fas fa-user"></i>
      </div>
      <input type="text" name="nama" class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium" placeholder="Masukkan Nama Lengkap beserta Gelar" required>
    </div>
  </div>

  <div>
    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
      Email / Username <span class="text-rose-500">*</span>
    </label>
    <div class="relative flex items-center">
      <div class="absolute left-3 text-slate-400 pointer-events-none text-xs">
        <i class="fas fa-envelope"></i>
      </div>
      <input type="email" name="email" class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium" placeholder="contoh@pa-banjarbaru.go.id" required>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-2">
    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
        NIP
      </label>
      <input type="text" name="nip" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium" placeholder="19800101 200501 1 001">
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
        Jabatan
      </label>
      <input type="text" name="jabatan" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium" placeholder="Staf Kepegawaian">
    </div>
  </div>

  <div>
    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
      Peran Akses <span class="text-rose-500">*</span>
    </label>
    <select name="role" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium">
      <option value="pegawai" selected>Staf / Pegawai (Pengelola Surat)</option>
      <option value="pimpinan">Pimpinan / Ketua (Penyetuju Surat)</option>
      <option value="admin">Administrator System</option>
    </select>
  </div>

  <div class="grid grid-cols-2 gap-2">
    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
        Password <span class="text-rose-500">*</span>
      </label>
      <input type="password" name="password" id="regPassword" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium" placeholder="Min. 6 karakter" required>
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
        Konfirmasi <span class="text-rose-500">*</span>
      </label>
      <input type="password" name="confirmPassword" id="regConfirmPassword" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition outline-none font-medium" placeholder="Ulangi Password" required>
    </div>
  </div>

  <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-700 hover:via-purple-700 hover:to-pink-700 text-white rounded-xl font-bold text-xs shadow-md shadow-indigo-500/20 transition duration-200 cursor-pointer flex items-center justify-center gap-2 mt-2">
    <i class="fas fa-user-plus"></i> Buat Akun Sekarang
  </button>
</form>

<div class="mt-4 pt-3 border-t border-slate-100 text-center">
  <p class="text-xs text-slate-600 m-0">
    Sudah memiliki akun? 
    <a href="/auth/login" class="font-bold text-indigo-600 hover:text-indigo-800 transition inline-flex items-center gap-1 ml-1 hover:underline">
      <i class="fas fa-sign-in-alt"></i> Masuk di sini
    </a>
  </p>
</div>

<%- include('../layouts/base-login-footer') %>
