<%- include('../layouts/base-header') %>

  <div class="container mx-auto py-6 px-4">
    <div class="max-w-6xl mx-auto space-y-6">

      <!-- Header -->
      <div
        class="bg-gradient-to-r from-blue-700 via-indigo-700 to-purple-800 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row items-center justify-between">
        <div class="flex items-center space-x-4 mb-4 md:mb-0">
          <div class="p-3 bg-white/10 backdrop-blur-md rounded-xl text-2xl">
            <i class="fas fa-users text-yellow-300"></i>
          </div>
          <div>
            <h1 class="text-2xl font-bold tracking-tight">Manajemen Pegawai</h1>
            <p class="text-blue-100 text-sm mt-0.5">Daftar Pegawai dan Pejabat Pengadilan Agama Banjarbaru</p>
          </div>
        </div>
        <button onclick="document.getElementById('modalTambahPegawai').classList.remove('hidden')"
          class="px-5 py-2.5 bg-white text-blue-800 hover:bg-blue-50 font-bold rounded-xl text-sm shadow transition flex items-center space-x-2">
          <i class="fas fa-user-plus text-blue-600"></i>
          <span>Tambah Pegawai Baru</span>
        </button>
      </div>

      <!-- Alert Notifications -->
      <% if (typeof success !=='undefined' && success) { %>
        <div
          class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 p-4 rounded-r-xl shadow-sm flex items-center justify-between">
          <div class="flex items-center">
            <i class="fas fa-check-circle text-emerald-500 text-xl mr-3"></i>
            <p class="font-semibold text-sm">
              <%= success %>
            </p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700"><i
              class="fas fa-times"></i></button>
        </div>
        <% } %>

          <!-- Pegawai Table -->
          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center space-x-2">
                <h3 class="font-bold text-gray-800">Daftar Pegawai Terdaftar</h3>
                <span class="px-2.5 py-0.5 bg-blue-100 text-blue-800 text-xs font-semibold rounded-full">
                  <%= pegawaiList ? pegawaiList.length : 0 %> Pegawai
                </span>
              </div>
              <div class="relative w-full sm:w-64">
                <input type="text" id="searchPegawai" onkeyup="filterPegawai()" placeholder="Cari nama / NIP..."
                  class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-9 pr-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                <i class="fas fa-search absolute left-3 top-3 text-gray-400 text-xs"></i>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm text-gray-600" id="tablePegawai">
                <thead class="bg-gray-50 text-xs uppercase font-bold text-gray-500 border-b border-gray-200">
                  <tr>
                    <th class="px-6 py-3.5">NIP & Nama</th>
                    <th class="px-6 py-3.5">Jabatan / Unit</th>
                    <th class="px-6 py-3.5">Pangkat / Golongan</th>
                    <th class="px-6 py-3.5">Email / Kontak</th>
                    <th class="px-6 py-3.5">Status</th>
                    <th class="px-6 py-3.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% if (pegawaiList && pegawaiList.length> 0) { %>
                    <% pegawaiList.forEach(function(p) { %>
                      <tr class="hover:bg-blue-50/50 transition">
                        <td class="px-6 py-4">
                          <div class="font-bold text-gray-900">
                            <%= p.nama %>
                          </div>
                          <div class="text-xs font-mono text-gray-500">NIP: <%= p.nip %>
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          <div class="font-semibold text-gray-800">
                            <%= p.jabatan %>
                          </div>
                          <div class="text-xs text-gray-500">
                            <%= p.unit || 'Pengadilan Agama Banjarbaru' %>
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          <span class="px-2.5 py-1 bg-gray-100 text-gray-700 rounded-lg text-xs font-medium">
                            <%= p.golongan %>
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <div class="text-xs font-medium text-gray-800">
                            <%= p.email %>
                          </div>
                          <div class="text-xs text-gray-400">
                            <%= p.telepon || '-' %>
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          <span
                            class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">Aktif</span>
                        </td>
                        <td class="px-6 py-4 text-right space-x-2">
                          <button onclick="alert('Detail Pegawai: <%= p.nama %>')"
                            class="px-3 py-1.5 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded-lg text-xs font-bold transition">
                            <i class="fas fa-eye"></i> Detail
                          </button>
                        </td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-400">Belum ada data pegawai.</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>

    </div>
  </div>

  <!-- Modal Tambah Pegawai -->
  <div id="modalTambahPegawai"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl relative space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 flex items-center">
          <i class="fas fa-user-plus text-blue-600 mr-2"></i> Tambah Pegawai Baru
        </h3>
        <button onclick="document.getElementById('modalTambahPegawai').classList.add('hidden')"
          class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times text-lg"></i>
        </button>
      </div>

      <form action="<%= url_for('pegawai.tambah') %>" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nama Lengkap</label>
          <input type="text" name="nama" required placeholder="Contoh: Drs. H. Ahmad Fauzi, M.H."
            class="w-full bg-gray-50 border border-gray-300 rounded-xl p-2.5 text-sm focus:ring-blue-500 focus:border-blue-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">NIP</label>
            <input type="text" name="nip" required placeholder="19800101 200501 1 001"
              class="w-full bg-gray-50 border border-gray-300 rounded-xl p-2.5 text-sm font-mono focus:ring-blue-500 focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pangkat / Golongan</label>
            <input type="text" name="golongan" required placeholder="Pembina Utama Muda (IV/c)"
              class="w-full bg-gray-50 border border-gray-300 rounded-xl p-2.5 text-sm focus:ring-blue-500 focus:border-blue-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Jabatan</label>
          <input type="text" name="jabatan" required placeholder="Ketua / Hakim / Panitera / Sekretaris"
            class="w-full bg-gray-50 border border-gray-300 rounded-xl p-2.5 text-sm focus:ring-blue-500 focus:border-blue-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Email</label>
            <input type="email" name="email" required placeholder="pegawai@pa-banjarbaru.go.id"
              class="w-full bg-gray-50 border border-gray-300 rounded-xl p-2.5 text-sm focus:ring-blue-500 focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nomor Telepon</label>
            <input type="text" name="telepon" placeholder="081234567890"
              class="w-full bg-gray-50 border border-gray-300 rounded-xl p-2.5 text-sm focus:ring-blue-500 focus:border-blue-500">
          </div>
        </div>

        <div class="pt-2 flex items-center justify-end space-x-3 border-t border-gray-100">
          <button type="button" onclick="document.getElementById('modalTambahPegawai').classList.add('hidden')"
            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-sm font-semibold transition">
            Batal
          </button>
          <button type="submit"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold shadow transition">
            Simpan Data
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function filterPegawai() {
      const input = document.getElementById('searchPegawai').value.toLowerCase();
      const rows = document.querySelectorAll('#tablePegawai tbody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
      });
    }
  </script>

  <%- include('../layouts/base-footer') %>