    </div>

    <div id="toast-container" class="fixed bottom-4 right-4 z-50 space-y-2"></div>
  </div>

  <!-- Global Reject Modal for Notifications -->
  <div id="globalRejectModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-sm transition-all duration-300 opacity-0 invisible pointer-events-none">
    <div id="globalRejectBox" class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 transform transition-all duration-300 translateY-5 scale-95 border border-gray-100">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100 mb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-red-100 text-red-600 flex items-center justify-center text-lg font-bold">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-gray-900 m-0">Tolak Persetujuan Surat</h3>
            <p id="globalRejectSubtitle" class="text-xs text-gray-500 m-0"></p>
          </div>
        </div>
        <button type="button" onclick="closeGlobalRejectModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg transition">
          <i class="fas fa-times text-lg"></i>
        </button>
      </div>
      
      <div class="mb-4">
        <label for="globalRejectReason" class="block text-xs font-semibold text-gray-700 mb-1.5">
          Alasan Penolakan <span class="text-red-500">*</span>
        </label>
        <textarea id="globalRejectReason" rows="4" 
                  class="w-full px-3 py-2 text-xs text-gray-800 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-red-500 focus:ring-2 focus:ring-red-200 transition outline-none resize-none"
                  placeholder="Masukkan alasan penolakan surat ini secara lengkap..."
                  oninput="document.getElementById('globalRejectCounter').textContent = this.value.length + ' / 500'"></textarea>
        <div class="flex justify-between items-center mt-1">
          <span class="text-[10px] text-gray-400">Wajib diisi untuk catatan penolakan</span>
          <span id="globalRejectCounter" class="text-[10px] text-gray-400">0 / 500</span>
        </div>
      </div>

      <div class="flex gap-2 justify-end pt-2 border-t border-gray-100">
        <button type="button" onclick="closeGlobalRejectModal()" 
                class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-600 hover:bg-gray-100 transition">
          Batal
        </button>
        <button id="globalRejectSubmitBtn" type="button" onclick="submitGlobalReject()"
                class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-red-600 hover:bg-red-700 transition shadow-md shadow-red-200 flex items-center gap-1.5">
          <i class="fas fa-times"></i> Tolak Surat
        </button>
      </div>
    </div>
  </div>

  <!-- External Libraries -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.3/viewer.min.js"></script>

  <!-- Notif bell toggle -->
  <script>
  function toggleNotifDropdown(e) {
    e.preventDefault();
    e.stopPropagation();
    var dd = document.querySelector('.notification-dropdown');
    if (!dd) return;

    var computed = window.getComputedStyle(dd).display;
    var isOpen = (computed !== 'none');

    if (isOpen) {
      dd.style.display = 'none';
    } else {
      dd.style.display = 'flex';
      if (typeof refreshNotificationDropdown === 'function') {
        refreshNotificationDropdown();
      }
    }
  }

  document.addEventListener('click', function(e) {
    var dd = document.querySelector('.notification-dropdown');
    var bell = document.getElementById('notifBellBtn');
    if (!dd || !bell) return;
    if (!dd.contains(e.target) && !bell.contains(e.target)) {
      dd.style.display = 'none';
    }
  });

  function toggleMenu(e, id) {
    e.preventDefault();
    var el = document.getElementById(id);
    if (el) {
      if (el.style.display === 'block') {
        el.style.display = 'none';
      } else {
        el.style.display = 'block';
      }
    }
  }
  </script>

