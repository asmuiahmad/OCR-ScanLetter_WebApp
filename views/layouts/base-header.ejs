<!DOCTYPE html>
<html lang="en">
<%- include('../includes/head') %>

<body class="bg-gray-50">
  <meta name="csrf-token" content="<%= csrf_token() %>">
  <div class="modern-sidebar">
    <div class="logo-details" id="sidebarToggle">
      <i class="fas fa-envelope-open-text"></i>
      <span class="logo_name font-bold tracking-wide">Surat App</span>
    </div>
    <ul class="nav-links">
      <!-- 1. DASHBOARD -->
      <li>
        <a href="<%= url_for('dashboard.dashboard') %>" data-tooltip="Dashboard" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-home"></i>
            <span class="links_name">Dashboard</span>
          </div>
        </a>
      </li>

      <!-- 2. DAFTAR SURAT -->
      <li>
        <a href="#" onclick="toggleMenu(event, 'showSuratMenu')" data-tooltip="Daftar Surat" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-envelope-open-text"></i>
            <span class="links_name">Daftar Surat</span>
            <i class="fas fa-chevron-down"></i>
          </div>
        </a>
        <div class="dropdown" id="showSuratMenu">
          <a href="<%= url_for('surat_masuk.show_surat_masuk') %>">Surat Masuk</a>
          <a href="<%= url_for('surat_keluar.show_surat_keluar') %>">Surat Keluar</a>
        </div>
      </li>

      <!-- 3. INPUT SURAT (Admin) -->
      <% if (current_user && current_user.role === 'admin') { %>
      <li>
        <a href="#" onclick="toggleMenu(event, 'inputSuratMenu')" data-tooltip="Input Surat" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-edit"></i>
            <span class="links_name">Input Surat</span>
            <i class="fas fa-chevron-down"></i>
          </div>
        </a>
        <div class="dropdown" id="inputSuratMenu">
          <a href="<%= url_for('surat_masuk.input') %>">Input Surat Masuk</a>
          <a href="<%= url_for('surat_keluar.input') %>">Input Surat Keluar</a>
        </div>
      </li>

      <!-- 4. PROSES OCR (Admin) -->
      <li>
        <a href="#" onclick="toggleMenu(event, 'ocrMenu')" data-tooltip="Proses OCR" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-eye"></i>
            <span class="links_name">Proses OCR</span>
            <i class="fas fa-chevron-down"></i>
          </div>
        </a>
        <div class="dropdown" id="ocrMenu">
          <a href="<%= url_for('ocr.ocr_surat_masuk') %>">OCR Surat Masuk</a>
          <a href="<%= url_for('ocr.ocr_surat_keluar') %>">OCR Surat Keluar</a>
          <a href="<%= url_for('ocr.ocr_cuti') %>">OCR Form Cuti</a>
        </div>
      </li>
      <% } %>

      <!-- 5. PERSETUJUAN SURAT (Pimpinan & Admin) -->
      <% if (current_user && (current_user.role === 'pimpinan' || current_user.role === 'admin')) { %>
      <li>
        <a href="<%= url_for('persetujuan.surat_masuk') %>" data-tooltip="Persetujuan Surat" class="flex items-center">
          <div class="flex items-center w-full relative">
            <i class="fas fa-check-circle"></i>
            <span class="links_name">Persetujuan Surat</span>
            <% if ((locals.g && g.pending_masuk_count + g.pending_keluar_count) > 0) { %>
            <span class="ml-auto bg-gradient-to-r from-pink-500 to-red-500 text-white text-xs font-bold rounded-full shadow px-2 py-0.5 flex items-center justify-center min-w-[20px] h-5 border border-white">
              <%= g.pending_masuk_count + g.pending_keluar_count %>
            </span>
            <% } %>
          </div>
        </a>
      </li>
      <% } %>

      <!-- 6. DISPOSISI SURAT -->
      <li>
        <a href="<%= url_for('disposisi.daftar') %>" data-tooltip="Disposisi Surat" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-share-alt"></i>
            <span class="links_name">Disposisi Surat</span>
          </div>
        </a>
      </li>

      <!-- 7. MANAJEMEN CUTI -->
      <li>
        <a href="<%= url_for('cuti.daftar') %>" data-tooltip="Manajemen Cuti" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-calendar-alt"></i>
            <span class="links_name">Manajemen Cuti</span>
          </div>
        </a>
      </li>

      <!-- 8. DATA PEGAWAI -->
      <li>
        <a href="<%= url_for('pegawai.index') %>" data-tooltip="Data Pegawai" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-users"></i>
            <span class="links_name">Data Pegawai</span>
          </div>
        </a>
      </li>

      <!-- 9. TEMPLATES SURAT -->
      <li class="<%= breadcrumb_active === 'Templates Surat' ? 'active' : '' %>">
        <a href="/templates" data-tooltip="Templates Surat" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-file-contract"></i>
            <span class="links_name">Templates Surat</span>
          </div>
        </a>
      </li>

      <!-- 10. LAPORAN & STATISTIK -->
      <li>
        <a href="#" onclick="toggleMenu(event, 'laporanMenu')" data-tooltip="Laporan" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-chart-bar"></i>
            <span class="links_name">Laporan</span>
            <i class="fas fa-chevron-down"></i>
          </div>
        </a>
        <div class="dropdown" id="laporanMenu">
          <a href="<%= url_for('laporan.statistik') %>">Statistik Surat</a>
          <a href="<%= url_for('laporan.cetak') %>">Laporan Cetak / Rekap</a>
        </div>
      </li>

      <!-- 11. MANAJEMEN USER (Admin) -->
      <% if (current_user && current_user.is_admin) { %>
      <li>
        <a href="<%= url_for('users.index') %>" data-tooltip="Manajemen User" class="flex items-center">
          <div class="flex items-center w-full">
            <i class="fas fa-user-cog"></i>
            <span class="links_name">Manajemen User</span>
          </div>
        </a>
      </li>
      <% } %>
    </ul>

    <% if (current_user) { %>
    <div class="sidebar-user-profile">
      <div class="user-profile-container">
        <a class="user-avatar flex items-center justify-center rounded-full bg-gray-200 hover:bg-blue-200 transition" id="sidebarUserAvatar" href="#" style="width:60px; height:60px; cursor:pointer; position:relative; display:inline-flex;" data-tooltip="<%= current_user.email.split('@')[0] %> (<%= current_user.role.charAt(0).toUpperCase() + current_user.role.slice(1) %>)">
          <i class="fas fa-user-circle text-blue-700"></i>
        </a>
        <div class="user-info">
          <div class="user-name"><%= current_user.email.split('@')[0] %></div>
          <div class="user-email"><%= current_user.email %></div>
          <div class="user-role-badge" data-role="<%= current_user.role %>" style="margin-top:-12px;"><%= current_user.role.toUpperCase() %></div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <div class="main-content">
    <!-- SPA Progress Bar -->
    <div class="spa-progress" id="spaProgress">
      <div class="spa-progress-bar" id="spaProgressBar"></div>
    </div>

    <nav class="bg-white shadow-sm sticky top-0" style="z-index:1000; position:relative;">
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a class="flex items-center text-lg font-semibold text-gray-800" href="<%= url_for('dashboard.dashboard') %>">
              <i class="fas fa-envelope-open-text text-blue-600 mr-2"></i>
              Surat Masuk dan Surat Keluar
            </a>
          </div>
          <div class="flex items-center">
            <div class="flex items-center">
              <div class="hidden sm:flex sm:items-center">
            <% if (current_user && (current_user.role === 'pimpinan' || current_user.role === 'admin')) { %>
              <% let _total_pending = g.pending_masuk_count + g.pending_keluar_count; %>
              <div class="relative" style="margin-right:0.5rem; z-index:1001; position:relative;">
                <button class="notification-bell-btn relative <% if (_total_pending > 0) { %>has-notifications<% } %>"
                        title="Notifikasi Persetujuan Surat"
                        type="button"
                        id="notifBellBtn"
                        onclick="toggleNotifDropdown(event)"
                        style="position:relative; z-index:1001; cursor:pointer; pointer-events:auto !important;">
                  <i class="fas fa-bell"></i>
                  <% if (_total_pending > 0) { %>
                  <span class="notif-badge absolute bg-red-500 text-white text-xs rounded-full min-w-[20px] h-5 flex items-center justify-center font-bold px-1" style="top:-4px;right:-4px;z-index:10;">
                    <%= _total_pending %>
                  </span>
                  <% } %>
                </button>
                <!-- Dropdown — toggled by JS -->
                <div class="notification-dropdown">
                  <!-- Header -->
                  <div class="px-4 py-3 border-b border-gray-100 flex-shrink-0" style="background:linear-gradient(135deg,#1e40af,#3b82f6);">
                    <div class="flex items-center justify-between">
                      <h3 class="text-sm font-bold text-white flex items-center gap-2 m-0">
                        <i class="fas fa-bell"></i> Persetujuan Surat
                      </h3>
                      <div class="flex items-center gap-1.5 text-xs">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full font-medium" style="background:rgba(255,255,255,0.2);color:white;">
                          <i class="fas fa-inbox"></i>
                          Masuk: <span id="notifCountMasukValue" class="font-bold"><%= g.pending_masuk_count %></span>
                        </span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full font-medium" style="background:rgba(255,255,255,0.2);color:white;">
                          <i class="fas fa-paper-plane"></i>
                          Keluar: <span id="notifCountKeluarValue" class="font-bold"><%= g.pending_keluar_count %></span>
                        </span>
                      </div>
                    </div>
                  </div>
                  <!-- Scrollable content -->
                  <div class="notification-content" style="overflow-y:auto; flex:1; max-height:380px;">
                    <ul class="notif-list font-sans m-0 p-0 list-none divide-y divide-gray-100">
                      <% if (typeof g !== 'undefined' && g.pending_items && g.pending_items.length > 0) { %>
                        <% g.pending_items.forEach(function(surat) { %>
                          <% let isMasuk = surat.type_lower === 'masuk' || surat.type === 'Masuk'; %>
                          <% let typeLabel = isMasuk ? 'Surat Masuk' : 'Surat Keluar'; %>
                          <% let typeIcon = isMasuk ? 'fa-inbox' : 'fa-paper-plane'; %>
                          <% let badgeCls = isMasuk ? 'bg-blue-100 text-blue-700 border border-blue-200' : 'bg-purple-100 text-purple-700 border border-purple-200'; %>
                          <li>
                            <div class="px-4 py-3 hover:bg-gray-50 transition-colors group">
                              <div class="flex items-center justify-between mb-1.5">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold <%= badgeCls %>">
                                  <i class="fas <%= typeIcon %>"></i> <%= typeLabel %>
                                </span>
                                <% if (surat.created_at) { %>
                                  <span class="text-xs text-gray-400 flex items-center gap-1"><i class="far fa-clock"></i> <%= surat.created_at %></span>
                                <% } %>
                              </div>
                              <div class="text-xs font-bold text-gray-700 flex items-center gap-1 mb-0.5">
                                <i class="fas fa-hashtag text-gray-400"></i><%= surat.nomor %>
                              </div>
                              <div class="text-xs text-gray-600 flex items-center gap-1 mb-0.5 truncate">
                                <i class="fas fa-user text-gray-400 flex-shrink-0"></i>
                                <span class="truncate"><%= surat.pengirim %></span>
                                <i class="fas fa-arrow-right text-gray-300 flex-shrink-0 text-[10px]"></i>
                                <span class="truncate"><%= surat.penerima %></span>
                              </div>
                              <div class="text-xs text-gray-400 flex items-center gap-1 mb-2">
                                <i class="far fa-calendar-alt"></i><%= surat.tanggal %>
                              </div>
                              <div class="flex gap-2">
                                <button onclick="approveSurat(<%= surat.id %>, this, '<%= isMasuk ? 'masuk' : 'keluar' %>')"
                                        class="flex-1 flex items-center justify-center gap-1.5 py-1.5 rounded-lg text-xs font-semibold text-white border-none cursor-pointer transition"
                                        style="background:linear-gradient(135deg,#059669,#10b981);"
                                        title="Setujui Surat">
                                  <i class="fas fa-check"></i> Setujui
                                </button>
                                <button onclick="rejectSurat(<%= surat.id %>, this, '<%= isMasuk ? 'masuk' : 'keluar' %>')"
                                        class="flex-1 flex items-center justify-center gap-1.5 py-1.5 rounded-lg text-xs font-semibold text-white border-none cursor-pointer transition"
                                        style="background:linear-gradient(135deg,#dc2626,#ef4444);"
                                        title="Tolak Surat">
                                  <i class="fas fa-times"></i> Tolak
                                </button>
                              </div>
                            </div>
                          </li>
                        <% }); %>
                      <% } %>
                    </ul>
                    <div class="notif-empty" style="display:<%= (g && (g.pending_masuk_count + g.pending_keluar_count) > 0) ? 'none' : 'block' %>; padding:2rem 1.25rem; text-align:center; color:#9ca3af;">
                      <i class="fas fa-check-circle" style="font-size:2rem; color:#34d399; display:block; margin-bottom:0.5rem;"></i>
                      <div style="font-size:0.875rem; font-weight:500;">Semua surat sudah diproses</div>
                      <div style="font-size:0.75rem; margin-top:0.25rem;">Tidak ada surat yang menunggu persetujuan</div>
                    </div>
                  </div>
                  <!-- Footer link -->
                  <div class="p-2 border-t border-gray-100 text-center bg-gray-50">
                    <a href="<%= url_for('persetujuan.surat_masuk') %>" class="text-xs font-bold text-blue-600 hover:text-blue-800 transition block py-1">
                      Lihat Semua Halaman Persetujuan &rarr;
                    </a>
                  </div>
                </div>
              </div>
            <% } %>
                <div class="relative ml-2">
                <a href="<%= url_for('auth.logout') %>" class="flex items-center px-3 py-2 text-sm font-medium text-gray-700 hover:text-red-600 transition-colors duration-200">
                  <i class="fas fa-sign-out-alt mr-1"></i>
                  Logout
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <nav class="bg-white px-3 py-2 border-b border-gray-200">
      <ol class="flex flex-wrap items-center text-xs">
        <li class="flex items-center">
          <a href="<%= url_for('dashboard.dashboard') %>" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">
            <i class="fas fa-home mr-1 text-xs"></i>
            Home
          </a>
          <svg class="h-4 w-4 text-gray-400 mx-1.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
        </li>
        <li class="flex items-center">
          <span class="text-gray-800 font-medium"><%= typeof breadcrumb_active !== 'undefined' ? breadcrumb_active : 'Dashboard' %></span>
        </li>
      </ol>
    </nav>

    <div class="content p-4 sm:p-6 overflow-y-auto">
