<%- include('../layouts/base-header') %>

<div class="container mx-auto py-6 px-4">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Top Banner Header -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-blue-900 rounded-2xl p-6 text-white shadow-xl border border-indigo-800/40 relative overflow-hidden">
      <!-- Ambient Glow -->
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 relative z-10">
        <div class="flex items-center gap-4 justify-start text-left w-full md:w-auto">
          <div class="w-13 h-13 bg-amber-500/20 border border-amber-400/40 rounded-2xl flex items-center justify-center text-2xl text-amber-400 shadow-inner shrink-0">
            <i class="fas fa-file-signature"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-2xl font-black tracking-tight text-white">Persetujuan Surat Pimpinan</h1>
              <span class="px-2.5 py-0.5 bg-amber-400/20 text-amber-300 border border-amber-400/30 text-[10px] font-extrabold uppercase tracking-wider rounded-md">
                E-VERIFIKASI
              </span>
            </div>
            <p class="text-slate-300 text-xs mt-1">Verifikasi, validasi digital, dan pembubuhan tanda tangan surat Pengadilan Agama Banjarbaru</p>
          </div>
        </div>

        <!-- Quick Summary Stats Pills -->
        <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
          <div class="flex items-center gap-2 bg-slate-800/80 backdrop-blur-md border border-slate-700/80 px-3.5 py-2 rounded-xl text-xs font-semibold">
            <i class="fas fa-inbox text-blue-400"></i>
            <span class="text-slate-300">Masuk:</span>
            <span class="font-bold text-white font-mono"><%= pendingList ? pendingList.filter(s => s.type === 'Masuk').length : 0 %></span>
          </div>
          <div class="flex items-center gap-2 bg-slate-800/80 backdrop-blur-md border border-slate-700/80 px-3.5 py-2 rounded-xl text-xs font-semibold">
            <i class="fas fa-paper-plane text-purple-400"></i>
            <span class="text-slate-300">Keluar:</span>
            <span class="font-bold text-white font-mono"><%= pendingList ? pendingList.filter(s => s.type === 'Keluar').length : 0 %></span>
          </div>
          <div class="flex items-center gap-2 bg-amber-500/20 border border-amber-400/40 px-4 py-2 rounded-xl text-xs font-bold text-amber-300 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
            </span>
            <span><%= pendingList ? pendingList.length : 0 %> Perlu Verifikasi</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Alert Notifications -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-900 p-4 rounded-r-2xl shadow-sm flex items-center justify-between transition-all duration-300 animate-fadeIn">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
          <i class="fas fa-check-circle"></i>
        </div>
        <div>
          <p class="font-bold text-xs uppercase tracking-wider text-emerald-700">Berhasil Diproses</p>
          <p class="text-xs font-medium text-emerald-900 mt-0.5"><%= success %></p>
        </div>
      </div>
      <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1.5 rounded-lg hover:bg-emerald-100 transition"><i class="fas fa-times"></i></button>
    </div>
    <% } %>

    <!-- Persetujuan Main Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      
      <!-- Table Header Bar & Filter Tabs -->
      <div class="p-4 sm:p-5 border-b border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-slate-50/50">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-indigo-100 text-indigo-700 rounded-xl text-sm font-bold">
            <i class="fas fa-tasks"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-slate-800 text-sm">Daftar Surat Menunggu Keputusan Pimpinan</h3>
            <p class="text-slate-500 text-[11px]">Tinjau isi berkas fisik sebelum memberikan persetujuan atau penolakan</p>
          </div>
        </div>

        <!-- Filter Pill Controls -->
        <div class="flex items-center gap-1.5 bg-slate-200/70 p-1 rounded-xl text-xs font-bold self-stretch sm:self-auto">
          <button type="button" onclick="filterTable('all')" class="filter-btn active px-3 py-1.5 rounded-lg bg-white text-indigo-900 shadow-xs transition text-center flex-1 sm:flex-none">Semua (<%= pendingList ? pendingList.length : 0 %>)</button>
          <button type="button" onclick="filterTable('Masuk')" class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition text-center flex-1 sm:flex-none">Surat Masuk</button>
          <button type="button" onclick="filterTable('Keluar')" class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition text-center flex-1 sm:flex-none">Surat Keluar</button>
        </div>
      </div>

      <!-- Responsive Table Container -->
      <div class="overflow-x-auto scrollbar-thin">
        <table class="w-full text-left text-xs text-slate-600" id="persetujuanTable">
          <thead class="bg-slate-100/80 text-[11px] uppercase font-extrabold text-slate-600 border-b border-slate-200/80 select-none">
            <tr>
              <th class="px-5 py-3.5 w-12 text-center">No</th>
              <th class="px-5 py-3.5">Kategori & Nomor Surat</th>
              <th class="px-5 py-3.5">Tanggal</th>
              <th class="px-5 py-3.5">Pengirim & Penerima</th>
              <th class="px-5 py-3.5">Perihal / Ringkasan Isi</th>
              <th class="px-5 py-3.5 text-center w-36">Status</th>
              <th class="px-5 py-3.5 text-right min-w-[280px]">Tindakan Keputusan Pimpinan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (pendingList && pendingList.length > 0) { %>
              <% pendingList.forEach(function(s, idx) { %>
              <tr class="hover:bg-indigo-50/30 transition-colors group surat-row" data-type="<%= s.type %>">
                <td class="px-5 py-4 text-center font-bold text-slate-400 group-hover:text-slate-600">
                  <%= idx + 1 %>
                </td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-1.5 mb-1">
                    <% if (s.type === 'Masuk') { %>
                      <span class="px-2.5 py-0.5 text-[10px] font-extrabold rounded-md bg-blue-100 text-blue-800 border border-blue-200 flex items-center gap-1">
                        <i class="fas fa-inbox text-[9px]"></i> Surat Masuk
                      </span>
                    <% } else { %>
                      <span class="px-2.5 py-0.5 text-[10px] font-extrabold rounded-md bg-purple-100 text-purple-800 border border-purple-200 flex items-center gap-1">
                        <i class="fas fa-paper-plane text-[9px]"></i> Surat Keluar
                      </span>
                    <% } %>
                  </div>
                  <div class="font-mono text-xs font-bold text-slate-900 group-hover:text-indigo-700 transition-colors">
                    <%= s.nomor %>
                  </div>
                </td>
                <td class="px-5 py-4 text-xs font-medium text-slate-700 whitespace-nowrap">
                  <div class="flex items-center gap-1.5">
                    <i class="far fa-calendar-alt text-slate-400"></i>
                    <span><%= s.tanggal %></span>
                  </div>
                </td>
                <td class="px-5 py-4 text-xs">
                  <div class="font-bold text-slate-900 flex items-center gap-1.5">
                    <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Dari:</span>
                    <span class="truncate max-w-[180px]"><%= s.pengirim %></span>
                  </div>
                  <div class="text-slate-500 flex items-center gap-1.5 mt-0.5">
                    <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Ke:</span>
                    <span class="truncate max-w-[180px]"><%= s.penerima %></span>
                  </div>
                </td>
                <td class="px-5 py-4 text-xs font-medium text-slate-800 max-w-xs leading-relaxed">
                  <p class="line-clamp-2" title="<%= s.isi %>"><%= s.isi %></p>
                </td>
                <td class="px-5 py-4 text-center">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-100/90 text-amber-800 text-[11px] font-bold rounded-full border border-amber-300/80 shadow-2xs whitespace-nowrap">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    Perlu Verifikasi
                  </span>
                </td>
                <td class="px-5 py-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-2">
                    <!-- Preview Physical Letter Button -->
                    <button type="button" 
                            onclick='openPreviewFisikModal("<%= s.type %>", <%= JSON.stringify(s) %>)' 
                            class="px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-xl text-xs transition border border-indigo-200/80 active:scale-95 flex items-center gap-1.5 shadow-2xs"
                            title="Preview Bentuk Fisik Surat Resmi">
                      <i class="fas fa-file-invoice text-indigo-600"></i> Preview
                    </button>

                    <!-- Approve Form Button -->
                    <form action="/persetujuan/surat-masuk" method="POST" class="inline" onsubmit="event.preventDefault(); openCustomApproveModal(this);">
                      <input type="hidden" name="id" value="<%= s.id %>">
                      <input type="hidden" name="type" value="<%= s.type %>">
                      <input type="hidden" name="action" value="setujui">
                      <button type="submit" 
                              class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-xl text-xs transition flex items-center gap-1.5 shadow-sm hover:shadow hover:bg-emerald-600/90"
                              title="Setujui dan Terbitkan Tanda Tangan Digital">
                        <i class="fas fa-check text-xs"></i> Setujui
                      </button>
                    </form>

                    <!-- Reject Form Button -->
                    <form action="/persetujuan/surat-masuk" method="POST" class="inline" onsubmit="event.preventDefault(); openCustomRejectModal(this);">
                      <input type="hidden" name="id" value="<%= s.id %>">
                      <input type="hidden" name="type" value="<%= s.type %>">
                      <input type="hidden" name="action" value="tolak">
                      <button type="submit" 
                              class="px-3.5 py-1.5 bg-rose-600 hover:bg-rose-700 active:scale-95 text-white font-bold rounded-xl text-xs transition flex items-center gap-1.5 shadow-sm hover:shadow hover:bg-rose-600/90"
                              title="Tolak Verifikasi Surat">
                        <i class="fas fa-times text-xs"></i> Tolak
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="px-6 py-16 text-center bg-slate-50/50">
                  <div class="max-w-md mx-auto space-y-3">
                    <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl mx-auto shadow-sm border border-emerald-200">
                      <i class="fas fa-check-double"></i>
                    </div>
                    <h4 class="font-extrabold text-slate-800 text-base">Semua Berkas Surat Telah Diverifikasi!</h4>
                    <p class="text-xs text-slate-500 leading-relaxed">Tidak ada surat masuk maupun surat keluar yang membutuhkan persetujuan pimpinan saat ini.</p>
                    <div class="pt-2 flex items-center justify-center gap-3">
                      <a href="/surat-masuk/show_surat_masuk" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-xl text-xs transition shadow-sm">
                        <i class="fas fa-inbox mr-1"></i> Lihat Surat Masuk
                      </a>
                      <a href="/surat-keluar/show_surat_keluar" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl text-xs transition border border-slate-300">
                        <i class="fas fa-paper-plane mr-1"></i> Lihat Surat Keluar
                      </a>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Footer Help Info -->
      <div class="px-6 py-3 bg-slate-100/60 border-t border-slate-200/80 flex items-center justify-between text-xs text-slate-500">
        <div class="flex items-center gap-2">
          <i class="fas fa-shield-alt text-emerald-600"></i>
          <span>Pengesahan dokumen terenkripsi dengan QR Verification System PA Banjarbaru</span>
        </div>
        <div class="font-mono text-[11px] text-slate-400">
          PA-BJB &bull; E-APPROVAL V2.0
        </div>
      </div>
    </div>

  </div>
</div>

<!-- PREVIEW SURAT FISIK MODAL TEMPLATE -->
<div id="previewSuratFisikModalTemplate" onclick="if(event.target === this) closePreviewFisikModal(this.id)" class="fixed inset-0 bg-slate-900/70 backdrop-blur-md z-[10000] flex items-center justify-center p-2 sm:p-4 hidden transition-all duration-200">
  <div class="bg-slate-100 rounded-2xl shadow-2xl max-w-3xl w-full border border-slate-300 relative max-h-[92vh] flex flex-col transition-all duration-300" onclick="bringToFront(this.parentElement)">
    
    <!-- Window Topbar Header (macOS Finder Style) -->
    <div class="flex items-center justify-between px-5 py-3 bg-slate-800 text-white rounded-t-2xl border-b border-slate-700 select-none shrink-0">
      <!-- Traffic Light Controls -->
      <div class="flex items-center gap-2 group">
        <button type="button" onclick="closePreviewFisikModal()" title="Tutup (Close)" class="btn-close-window w-3.5 h-3.5 rounded-full bg-[#FF5F56] border border-[#E0443E] hover:bg-[#E0443E] active:scale-90 transition flex items-center justify-center text-[7px] text-slate-900 font-bold shadow-xs">
          <i class="fas fa-times opacity-0 group-hover:opacity-100 transition-opacity"></i>
        </button>
        <button type="button" onclick="minimizeModal('previewSuratFisikModalTemplate', 'Preview Fisik')" title="Minimalisir (Minimize)" class="btn-min-window w-3.5 h-3.5 rounded-full bg-[#FFBD2E] border border-[#DEA123] hover:bg-[#DEA123] active:scale-90 transition flex items-center justify-center text-[7px] text-slate-900 font-bold shadow-xs">
          <i class="fas fa-minus opacity-0 group-hover:opacity-100 transition-opacity"></i>
        </button>
        <button type="button" onclick="toggleModalFullscreen('previewSuratFisikModalTemplate')" title="Layar Penuh (Fullscreen)" class="btn-full-window w-3.5 h-3.5 rounded-full bg-[#27C93F] border border-[#1AAB29] hover:bg-[#1AAB29] active:scale-90 transition flex items-center justify-center text-[7px] text-slate-900 font-bold shadow-xs">
          <i class="fas fa-expand-alt opacity-0 group-hover:opacity-100 transition-opacity"></i>
        </button>
      </div>

      <!-- Header Title -->
      <div class="flex items-center gap-2">
        <i class="fas fa-file-invoice text-amber-400 text-sm"></i>
        <span class="text-xs font-bold tracking-wide pf-window-title">Preview Fisik Dokumen Surat</span>
      </div>

      <!-- Quick Action Icons (Zoom & Print) -->
      <div class="flex items-center gap-1.5">
        <button type="button" onclick="zoomPaperModal(this, -0.1)" title="Zoom Out (-)" class="p-1.5 hover:bg-slate-700 rounded-lg text-slate-300 hover:text-white text-xs transition">
          <i class="fas fa-search-minus"></i>
        </button>
        <button type="button" onclick="zoomPaperModal(this, 0.1)" title="Zoom In (+)" class="p-1.5 hover:bg-slate-700 rounded-lg text-slate-300 hover:text-white text-xs transition">
          <i class="fas fa-search-plus"></i>
        </button>
        <button type="button" onclick="printPhysicalDocument(this)" title="Cetak Dokumen / Simpan PDF" class="px-3 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-lg transition flex items-center gap-1 shadow-sm">
          <i class="fas fa-print"></i> Cetak PDF
        </button>
      </div>
    </div>

    <!-- Paper Sheet Container (Scrollable Paper Stage) -->
    <div class="p-4 sm:p-8 overflow-y-auto flex-1 bg-slate-200/80 flex justify-center items-start scrollbar-thin">
      
      <!-- Authentic Physical Paper Sheet (A4 Style) -->
      <div class="pf-paper bg-white text-slate-900 shadow-2xl border border-slate-300 p-8 sm:p-12 w-full max-w-2xl relative font-serif text-xs leading-relaxed transition-transform duration-200 min-h-[720px] flex flex-col justify-between">
        
        <!-- Status Watermark Stamp -->
        <div class="pf-stamp absolute top-10 right-10 border-4 border-amber-600/80 text-amber-700 font-extrabold uppercase px-3 py-1.5 rounded-xl text-xs rotate-[-12deg] pointer-events-none select-none tracking-widest bg-amber-50/50 backdrop-blur-xs flex items-center gap-1.5 shadow-sm">
          <i class="fas fa-clock text-sm"></i> DRAFT / PENDING
        </div>

        <div>
          <!-- Kop Surat Resmi Pengadilan Agama Banjarbaru -->
          <div class="text-center pb-3 border-b-4 border-double border-slate-900 mb-6 select-none">
            <div class="flex items-center justify-center gap-3 mb-2">
              <div class="w-14 h-14 rounded-full bg-emerald-900 text-amber-300 flex items-center justify-center text-xl font-bold border-2 border-amber-400 shadow-sm shrink-0">
                <i class="fas fa-balance-scale"></i>
              </div>
              <div class="text-center">
                <h2 class="text-[11px] font-bold uppercase tracking-widest text-slate-900 leading-tight">MAHKAMAH AGUNG REPUBLIK INDONESIA</h2>
                <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-800">PENGADILAN TINGGI AGAMA BANJARMASIN</h3>
                <h1 class="text-sm font-extrabold uppercase tracking-wide text-emerald-950">PENGADILAN AGAMA BANJARBARU KELAS I B</h1>
                <p class="text-[9px] text-slate-600 italic font-sans mt-0.5">Jl. Trikora No. 01, Loktabat Selatan, Kota Banjarbaru, Kalimantan Selatan 70714</p>
                <p class="text-[8px] text-slate-500 font-sans">Situs Web: www.pa-banjarbaru.go.id | Pos El: info@pa-banjarbaru.go.id</p>
              </div>
            </div>
          </div>

          <!-- Letter Meta & Date Grid -->
          <div class="flex justify-between items-start mb-6 font-sans text-xs">
            <div class="space-y-1">
              <div><span class="font-bold w-20 inline-block">Nomor</span>: <span class="pf-nomor font-mono font-bold text-slate-900">W15-A12/902/HM.01/VII/2026</span></div>
              <div><span class="font-bold w-20 inline-block">Lampiran</span>: <span>1 (satu) Berkas Lengkap</span></div>
              <div><span class="font-bold w-20 inline-block">Perihal</span>: <span class="pf-perihal font-bold text-slate-900 underline">Undangan & Permohonan Dokumen</span></div>
            </div>
            <div class="text-right font-semibold text-slate-800">
              <div class="pf-tanggal">Banjarbaru, 19 Juli 2026</div>
            </div>
          </div>

          <!-- Destination Address -->
          <div class="mb-6 font-sans text-xs space-y-1">
            <div>Kepada Yth.</div>
            <div class="pf-penerima font-bold text-slate-900 text-sm">Wali Kota Banjarbaru</div>
            <div>di -</div>
            <div class="pl-4 italic text-slate-700">Tempat</div>
          </div>

          <!-- Letter Body Paragraphs -->
          <div class="space-y-3 text-justify text-slate-900 font-serif leading-relaxed text-xs">
            <p>Dengan hormat,</p>
            <p>
              Sehubungan dengan pelaksanaan tugas pokok, fungsi kepemerintahan, serta tertib administrasi di lingkungan Pengadilan Agama Banjarbaru, bersama ini kami sampaikan dokumen resmi terkait:
            </p>
            
            <!-- Boxed Letter Content Detail -->
            <div class="p-4 bg-slate-50 border-l-4 border-emerald-800 rounded-r-lg font-sans my-3 text-slate-800 leading-normal">
              <span class="block text-[10px] font-bold text-emerald-900 uppercase tracking-wider mb-1">Rincian / Perihal Isi Surat:</span>
              <p class="pf-isi font-medium m-0 text-slate-900 text-xs">
                Surat Permohonan Dukungan Fasilitas Pelaksanaan Sidang Terpadu Isbat Nikah TA 2026.
              </p>
            </div>

            <p>
              Demikian surat ini kami sampaikan untuk dapat dipergunakan sebagaimana mestinya. Atas perhatian, dukungan, dan kerja sama Bapak/Ibu, kami ucapkan terima kasih.
            </p>
          </div>
        </div>

        <!-- Official Signature & Digital Seal Footer -->
        <div class="mt-12 pt-4 flex justify-between items-end font-sans select-none">
          <!-- E-Seal / QR Code Verification Badge -->
          <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl flex items-center gap-3">
            <div class="w-12 h-12 bg-white border border-slate-300 rounded-lg p-1 flex items-center justify-center text-slate-800 shrink-0">
              <i class="fas fa-qrcode text-3xl"></i>
            </div>
            <div class="text-[9px] text-slate-600 leading-tight">
              <span class="font-bold text-emerald-800 block uppercase">E-SIGNATURE MAHKAMAH AGUNG</span>
              <span>Dokumen ini telah ditandatangani secara elektronik & terverifikasi sistem database PA Banjarbaru.</span>
            </div>
          </div>

          <!-- Signature Block -->
          <div class="text-center space-y-1 font-serif min-w-[200px]">
            <div class="text-xs font-bold text-slate-800">An. KETUA PENGADILAN AGAMA BANJARBARU</div>
            <div class="pf-pengirim-title text-[11px] text-slate-700">Pejabat Penandatangan</div>
            
            <!-- Digital Stamp Graphic -->
            <div class="h-16 flex items-center justify-center relative my-1">
              <span class="font-serif italic text-slate-400 text-[10px] uppercase tracking-widest opacity-60">[ Tanda Tangan Digital ]</span>
              <div class="absolute inset-0 flex items-center justify-center opacity-25 text-emerald-800 pointer-events-none">
                <i class="fas fa-stamp text-4xl rotate-12"></i>
              </div>
            </div>

            <div class="pf-signer font-extrabold text-xs text-slate-900 underline">Drs. H. Muhammad, M.H.</div>
            <div class="text-[10px] text-slate-600 font-mono">NIP. 19650412 199203 1 003</div>
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Footer Bar -->
    <div class="px-5 py-3 bg-white rounded-b-2xl border-t border-slate-200 flex items-center justify-between text-xs shrink-0">
      <div class="flex items-center gap-2 text-slate-500 text-[11px]">
        <i class="fas fa-database text-emerald-600"></i>
        <span>Data surat tersimpan sah di database Pengadilan Agama Banjarbaru</span>
      </div>
      <div class="flex items-center gap-2">
        <form id="modalApproveForm" action="/persetujuan/surat-masuk" method="POST" class="inline" onsubmit="event.preventDefault(); openCustomApproveModal(this);">
          <input type="hidden" name="id" id="modalApproveId">
          <input type="hidden" name="type" id="modalApproveType">
          <input type="hidden" name="action" value="setujui">
          <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm">
            <i class="fas fa-check"></i> Setujui Surat
          </button>
        </form>

        <form id="modalRejectForm" action="/persetujuan/surat-masuk" method="POST" class="inline" onsubmit="event.preventDefault(); openCustomRejectModal(this);">
          <input type="hidden" name="id" id="modalRejectId">
          <input type="hidden" name="type" id="modalRejectType">
          <input type="hidden" name="action" value="tolak">
          <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm">
            <i class="fas fa-times"></i> Tolak Surat
          </button>
        </form>

        <button type="button" onclick="closePreviewFisikModal(this.closest('[id^=\'preview\']').id)" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-xl transition">
          Tutup
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Floating Minimized Dock -->
<div id="minimizedDock" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-[10000] hidden flex items-center gap-3 bg-slate-900/95 text-white px-4 py-2.5 rounded-2xl border border-slate-700/80 shadow-2xl backdrop-blur-md text-xs transition-all duration-300 max-w-[90vw] overflow-x-auto">
  <div class="flex items-center gap-2 text-amber-400 font-bold text-[11px] uppercase tracking-wider pr-3 border-r border-slate-700/80 shrink-0">
    <i class="fas fa-window-minimize text-xs"></i>
    <span>Modal Di-minimize:</span>
  </div>
  <div id="minimizedDockList" class="flex items-center gap-2 shrink-0"></div>
</div>

<script>
// Filter Table Function
function filterTable(type) {
  const buttons = document.querySelectorAll('.filter-btn');
  buttons.forEach(btn => {
    btn.classList.remove('bg-white', 'text-indigo-900', 'shadow-xs');
    btn.classList.add('text-slate-600');
  });
  event.currentTarget.classList.add('bg-white', 'text-indigo-900', 'shadow-xs');
  event.currentTarget.classList.remove('text-slate-600');

  const rows = document.querySelectorAll('.surat-row');
  rows.forEach(row => {
    if (type === 'all' || row.dataset.type === type) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

// Window & Modal Management
function getOrCloneModal(templateId, newId) {
  let modal = document.getElementById(newId);
  if (!modal) {
    const template = document.getElementById(templateId);
    if (!template) return null;
    modal = template.cloneNode(true);
    modal.id = newId;
    document.body.appendChild(modal);
  }
  return modal;
}

function bringToFront(modalEl) {
  if (!modalEl) return;
  const modals = document.querySelectorAll('[id^="previewModal-"]');
  let highest = 10000;
  modals.forEach(m => {
    const z = parseInt(window.getComputedStyle(m).zIndex) || 10000;
    if (z > highest) highest = z;
  });
  modalEl.style.zIndex = highest + 1;
}

function openPreviewFisikModal(type, entry) {
  const modalId = `previewModal-${type.toLowerCase()}-${entry.id || Math.random().toString(36).substring(2,7)}`;
  const modal = getOrCloneModal('previewSuratFisikModalTemplate', modalId);
  if (!modal) return;

  modal.dataset.zoom = '1';

  modal.setAttribute('onclick', `if(event.target === this) closePreviewFisikModal('${modalId}')`);

  const closeBtn = modal.querySelector('.btn-close-window');
  if (closeBtn) closeBtn.setAttribute('onclick', `closePreviewFisikModal('${modalId}')`);

  const minBtn = modal.querySelector('.btn-min-window');
  if (minBtn) minBtn.setAttribute('onclick', `minimizeModal('${modalId}', 'Preview: ${entry.nomor || '-'}')`);

  const fullBtn = modal.querySelector('.btn-full-window');
  if (fullBtn) fullBtn.setAttribute('onclick', `toggleModalFullscreen('${modalId}')`);

  const windowTitle = modal.querySelector('.pf-window-title');
  if (windowTitle) windowTitle.innerText = `Preview Physical Letter (${type}): ${entry.nomor || ''}`;

  const nomorEl = modal.querySelector('.pf-nomor');
  if (nomorEl) nomorEl.innerText = entry.nomor || 'W15-A12/902/HM.01/VII/2026';

  const perihalEl = modal.querySelector('.pf-perihal');
  if (perihalEl) perihalEl.innerText = entry.isi || 'Penyampaian Berkas Dokumen Resmi';

  const tanggalEl = modal.querySelector('.pf-tanggal');
  if (tanggalEl) {
    const rawDate = entry.tanggal ? new Date(entry.tanggal) : new Date();
    const formatted = !isNaN(rawDate.getTime()) 
      ? rawDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
      : entry.tanggal || '19 Juli 2026';
    tanggalEl.innerText = 'Banjarbaru, ' + formatted;
  }

  const pengirimEl = modal.querySelector('.pf-pengirim-title');
  if (pengirimEl) pengirimEl.innerText = entry.pengirim || 'Pengadilan Agama Banjarbaru';

  const penerimaEl = modal.querySelector('.pf-penerima');
  if (penerimaEl) penerimaEl.innerText = entry.penerima || 'Ketua Pengadilan Agama Banjarbaru';

  const isiEl = modal.querySelector('.pf-isi');
  if (isiEl) isiEl.innerText = entry.isi || 'Surat resminya telah diregistrasi di database Pengadilan Agama Banjarbaru.';

  const signerEl = modal.querySelector('.pf-signer');
  if (signerEl) signerEl.innerText = entry.approved_by || entry.pengirim || 'Drs. H. Muhammad, M.H.';

  // Modal approve and reject forms update
  const mApproveId = modal.querySelector('#modalApproveId');
  if (mApproveId) mApproveId.value = entry.id;
  const mApproveType = modal.querySelector('#modalApproveType');
  if (mApproveType) mApproveType.value = type;

  const mRejectId = modal.querySelector('#modalRejectId');
  if (mRejectId) mRejectId.value = entry.id;
  const mRejectType = modal.querySelector('#modalRejectType');
  if (mRejectType) mRejectType.value = type;

  removeMinimizedModal(modalId);
  modal.classList.remove('hidden');
}

function closePreviewFisikModal(modalId) {
  const id = modalId || 'previewSuratFisikModalTemplate';
  const modal = document.getElementById(id);
  if (modal) {
    const card = modal.querySelector('.bg-slate-100');
    if (card && card.classList.contains('is-fullscreen')) {
      toggleModalFullscreen(id);
    }
    modal.classList.add('hidden');
    if (id !== 'previewSuratFisikModalTemplate') {
      modal.remove();
    }
  }
  removeMinimizedModal(id);
}

function zoomPaperModal(btn, delta) {
  const modal = btn.closest('[id^="previewModal"]') || btn.closest('#previewSuratFisikModalTemplate');
  if (!modal) return;
  const paper = modal.querySelector('.pf-paper');
  if (!paper) return;
  let zoom = parseFloat(modal.dataset.zoom || '1') + delta;
  zoom = Math.min(Math.max(0.6, zoom), 1.4);
  modal.dataset.zoom = zoom.toString();
  paper.style.transform = `scale(${zoom})`;
  paper.style.transformOrigin = 'top center';
}

function printPhysicalDocument(btn) {
  const modal = btn.closest('[id^="previewModal"]') || btn.closest('#previewSuratFisikModalTemplate');
  if (!modal) {
    window.print();
    return;
  }
  const paper = modal.querySelector('.pf-paper');
  if (!paper) {
    window.print();
    return;
  }
  
  const printWin = window.open('', '_blank', 'width=800,height=900');
  if (printWin) {
    printWin.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Cetak Surat Fisik Resmi</title>
        <script src="https://cdn.tailwindcss.com"><\/script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <style>
          @page { size: A4; margin: 15mm; }
          body { font-family: Georgia, serif; background: white; color: black; }
        </style>
      </head>
      <body class="p-6">
        <div class="max-w-2xl mx-auto">
          ${paper.outerHTML}
        </div>
        <script>
          setTimeout(() => {
            window.print();
          }, 600);
        <\/script>
      </body>
      </html>
    `);
    printWin.document.close();
  } else {
    window.print();
  }
}

// Window Minimize & Fullscreen Helper
function minimizeModal(modalId, label) {
  const modal = document.getElementById(modalId);
  if (!modal) return;
  modal.classList.add('hidden');

  const dock = document.getElementById('minimizedDock');
  const dockList = document.getElementById('minimizedDockList');
  if (!dock || !dockList) return;

  if (!dockList.querySelector(`[data-modal-id="${modalId}"]`)) {
    const item = document.createElement('button');
    item.type = 'button';
    item.dataset.modalId = modalId;
    item.className = 'px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-xs transition border border-slate-600 flex items-center gap-1.5 shadow-sm';
    item.innerHTML = `<i class="fas fa-window-restore text-amber-400"></i> <span>${label}</span>`;
    item.onclick = function() {
      restoreModal(modalId);
    };
    dockList.appendChild(item);
  }
  dock.classList.remove('hidden');
}

function restoreModal(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) {
    modal.classList.remove('hidden');
    bringToFront(modal);
  }
  removeMinimizedModal(modalId);
}

function removeMinimizedModal(modalId) {
  const dockList = document.getElementById('minimizedDockList');
  if (dockList) {
    const btn = dockList.querySelector(`[data-modal-id="${modalId}"]`);
    if (btn) btn.remove();
    if (dockList.children.length === 0) {
      const dock = document.getElementById('minimizedDock');
      if (dock) dock.classList.add('hidden');
    }
  }
}

function toggleModalFullscreen(modalId) {
  const modal = document.getElementById(modalId);
  if (!modal) return;
  const card = modal.querySelector('.bg-slate-100');
  if (!card) return;

  if (card.classList.contains('is-fullscreen')) {
    card.classList.remove('is-fullscreen', 'fixed', 'inset-2', 'max-w-none', 'max-h-none', 'z-[10001]');
    card.classList.add('max-w-3xl', 'max-h-[92vh]');
  } else {
    card.classList.add('is-fullscreen', 'fixed', 'inset-2', 'max-w-none', 'max-h-none', 'z-[10001]');
    card.classList.remove('max-w-3xl', 'max-h-[92vh]');
  }
}

// Custom Modal Variables
let currentApproveForm = null;
let currentRejectForm = null;

function openCustomApproveModal(formElement) {
  currentApproveForm = formElement;
  const modal = document.getElementById('customApproveModal');
  if (modal) modal.classList.remove('hidden');
}

function closeCustomApproveModal() {
  currentApproveForm = null;
  const modal = document.getElementById('customApproveModal');
  if (modal) modal.classList.add('hidden');
}

function confirmCustomApprove() {
  if (currentApproveForm) {
    currentApproveForm.submit();
  }
}

function openCustomRejectModal(formElement) {
  currentRejectForm = formElement;
  const modal = document.getElementById('customRejectModal');
  if (modal) {
    const textarea = modal.querySelector('textarea[name="alasan_penolakan_input"]');
    if (textarea) textarea.value = '';
    modal.classList.remove('hidden');
  }
}

function closeCustomRejectModal() {
  currentRejectForm = null;
  const modal = document.getElementById('customRejectModal');
  if (modal) modal.classList.add('hidden');
}

function confirmCustomReject() {
  const modal = document.getElementById('customRejectModal');
  if (!modal || !currentRejectForm) return;

  const textarea = modal.querySelector('textarea[name="alasan_penolakan_input"]');
  const reason = textarea ? textarea.value.trim() : '';
  
  if (!reason) {
    alert('Alasan penolakan wajib diisi!');
    return;
  }

  // Create a hidden input to submit the reason
  const hiddenInput = document.createElement('input');
  hiddenInput.type = 'hidden';
  hiddenInput.name = 'alasan_penolakan';
  hiddenInput.value = reason;
  currentRejectForm.appendChild(hiddenInput);

  currentRejectForm.submit();
}
</script>

<!-- Custom Approve Modal -->
<div id="customApproveModal" class="fixed inset-0 z-[99999] hidden flex items-center justify-center">
  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeCustomApproveModal()"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-sm p-6 transform transition-all">
    <div class="flex items-center gap-3 mb-4 text-emerald-600">
      <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
        <i class="fas fa-check-circle text-xl"></i>
      </div>
      <h3 class="text-lg font-bold text-slate-800">Setujui Surat</h3>
    </div>
    <p class="text-sm text-slate-600 mb-6 font-medium">Apakah Anda yakin ingin MENYETUJUI surat ini dan menerbitkan tanda tangan digital?</p>
    <div class="flex items-center justify-end gap-2">
      <button type="button" onclick="closeCustomApproveModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-sm transition">
        Batal
      </button>
      <button type="button" onclick="confirmCustomApprove()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-sm transition shadow-sm">
        Ya, Setujui
      </button>
    </div>
  </div>
</div>

<!-- Custom Reject Modal -->
<div id="customRejectModal" class="fixed inset-0 z-[99999] hidden flex items-center justify-center">
  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeCustomRejectModal()"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg p-6 transform transition-all">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3 text-rose-600">
        <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center shrink-0">
          <i class="fas fa-times-circle text-xl"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800">Tolak Surat</h3>
      </div>
      <button type="button" onclick="closeCustomRejectModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition">
        <i class="fas fa-times"></i>
      </button>
    </div>
    
    <div class="mb-5">
      <p class="text-sm text-slate-600 font-medium mb-3">Sebutkan alasan penolakan surat ini agar dapat diperbaiki oleh staf terkait.</p>
      <div class="bg-rose-50 border border-rose-100 p-1 rounded-xl">
        <textarea name="alasan_penolakan_input" rows="3" class="w-full bg-transparent border-none p-3 text-sm focus:ring-0 resize-none font-medium text-slate-800 placeholder-rose-300" placeholder="Contoh: Lampiran kurang lengkap, mohon periksa kembali..."></textarea>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2">
      <button type="button" onclick="closeCustomRejectModal()" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-sm transition">
        Batal
      </button>
      <button type="button" onclick="confirmCustomReject()" class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-sm transition shadow-sm flex items-center gap-2">
        <i class="fas fa-paper-plane"></i> Kirim Penolakan
      </button>
    </div>
  </div>
</div>

